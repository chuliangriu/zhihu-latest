{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    },
    "api/catchall.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/catchall"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}

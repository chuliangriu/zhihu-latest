NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# mock：不请求外部模型；live：只从服务端 Secret 调用兼容接口。
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai-next.com
LLM_ALLOWED_HOSTS=api.openai-next.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=12000
# 整条 Workflow 共享的有限重试次数，不是每个节点各自重试。
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1500
LLM_INPUT_TOKEN_RESERVE=24000
# 用于监控页估算费用；按实际供应商价格填写。
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
PIPELINE_TIMEOUT_MS=25000

# 站内搜索目前只返回“发布或编辑时间”。默认关闭；只有接口提供可核实发布时间时，结果才会进入 7/14 天候选。
ZHIHU_PUBLIC_SEARCH_ENABLED=true
# 云端使用 http + 服务端 ZHIHU_ACCESS_SECRET；不要把 LLM Key 当知乎凭据。
ZHIHU_PUBLIC_SEARCH_TRANSPORT=http
# 联调可启用，前端标注演示时间；不代表原文在 14 天内发布。
ZHIHU_PUBLIC_DEMO_TIME_ENABLED=false
ZHIHU_ACCESS_SECRET=
PROFILE_SUMMARY_ENABLED=false
TOKEN_ENCRYPTION_KEY=

# 正式合入使用同事的 HttpOnly Session 与 Supabase；本地单元测试可保持 signed + memory。
AUTH_MODE=signed
CANDIDATE_MODE=fixture
PUBLIC_SOURCE_PROBABILITY=0.65
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BFF → 本服务的内部凭证。三项 Secret 均至少 32 字符，并且彼此不同。
APP_API_TOKEN=
IDENTITY_SIGNING_SECRET=
IP_HASH_SECRET=
ADMIN_USER_IDS=

# 本地保持 false。只有外部部署验收通过后才同时开启两项。
PUBLIC_DEPLOYMENT=false
PUBLIC_SECURITY_UNLOCK=false
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=32kb
REQUEST_CONTENT_LENGTH_MAX=32768

# 公网必须使用 redis；memory 只用于本地开发与自动化测试。
SECURITY_STORE_MODE=memory
BUSINESS_STORE_MODE=memory
REDIS_URL=
REDIS_PREFIX=unseen

RATE_IP_MAX=10
RATE_IP_WINDOW_MS=600000
RATE_USER_MAX=3
RATE_USER_WINDOW_MS=60000
DAILY_USER_WORKFLOWS=10
DAILY_IP_WORKFLOWS=30
DAILY_USER_LLM_REQUESTS=30
DAILY_GLOBAL_LLM_REQUESTS=1000
DAILY_USER_ZHIHU_SEARCH_REQUESTS=10
DAILY_GLOBAL_ZHIHU_SEARCH_REQUESTS=200
DAILY_USER_INPUT_TOKENS=240000
DAILY_USER_OUTPUT_TOKENS=30000
DAILY_GLOBAL_INPUT_TOKENS=12000000
DAILY_GLOBAL_OUTPUT_TOKENS=1500000
USER_CONCURRENCY_MAX=1
GLOBAL_CONCURRENCY_MAX=5
RESERVATION_LEASE_MS=90000
IDEMPOTENCY_TTL_MS=300000

MONITOR_RETENTION_DAYS=30
MONITOR_MAX_EVENTS_PER_DAY=20000

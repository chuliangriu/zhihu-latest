{
  "name": "unseen-people-discovery-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "security:scan-secrets": "node scripts/scan-secrets.mjs",
    "security:check": "npm run security:scan-secrets && npm audit --audit-level=moderate",
    "cli": "tsx src/cli/run.ts",
    "eval": "tsx src/cli/eval.ts",
    "smoke:workflow": "tsx src/cli/workflow-smoke.ts",
    "smoke:public": "tsx src/cli/public-smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "redis": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
